{#
  homepage.html.twig  →  deploy as  page--front.html.twig
  ──────────────────────────────────────────────────────
  Full-page override for the HiveSticks front page.

  Drupal architecture notes
  ─────────────────────────
  • Lives in:  themes/custom/hivesticks/templates/layout/page--front.html.twig
  • html.html.twig still owns <html>/<head>/<body> — this template only
    controls what goes inside <body>.
  • page.highlighted is kept so Drupal status/warning/error messages render.
  • page.content is output visually-hidden so Drupal internal blocks keep working.
  • All navigation / footer content is self-contained here.
  • All user-visible strings are wrapped in |t for translatability.
#}

{{ attach_library('hivesticks/homepage') }}

{# ── Accessibility: skip to main content ────────────────────────────────── #}
<a class="hs-skip-link" href="#main-content">{{ 'Skip to main content'|t }}</a>

{# ══════════════════════════════════════════════════════════════════════════
   NAVIGATION
   ══════════════════════════════════════════════════════════════════════════ #}
<header class="hs-nav" data-behavior="hs-sticky-nav" role="banner">
  <div class="hs-nav__inner">

    <a href="{{ path('<front>') }}" class="hs-nav__logo-link" aria-label="{{ 'HiveSticks — return to homepage'|t }}">
      {% if logo_url %}
        <img src="{{ logo_url }}" alt="{{ 'HiveSticks'|t }}" class="hs-nav__logo-img">
      {% else %}
        <span class="hs-nav__logo-wrap">
          {# Hexagonal hive icon #}
          <svg class="hs-nav__hex" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
            <path d="M15 2 L27 9 L27 21 L15 28 L3 21 L3 9 Z" fill="#d9871a"/>
            <path d="M15 8 C15 8 10 15 10 18.5 C10 21.54 12.24 24 15 24 C17.76 24 20 21.54 20 18.5 C20 15 15 8 15 8Z" fill="white" opacity="0.92"/>
          </svg>
          <span class="hs-nav__logo-text hs-serif">Hive<em>Sticks</em></span>
        </span>
      {% endif %}
    </a>

    <nav class="hs-nav__menu" aria-label="{{ 'Primary'|t }}">
      <ul class="hs-nav__links" role="list">
        <li><a href="/shop">{{ 'Shop'|t }}</a></li>
        <li><a href="#hs-flavors">{{ 'Flavors'|t }}</a></li>
        <li><a href="#hs-story">{{ 'Our Story'|t }}</a></li>
        <li><a href="#hs-athletes">{{ 'For Families'|t }}</a></li>
        <li><a href="#hs-faq">{{ 'FAQ'|t }}</a></li>
      </ul>
    </nav>

    <div class="hs-nav__actions">

      {# ── Account: avatar chip (logged in) / sign in ── #}
      {% if logged_in %}
        <a href="/user/{{ user.id }}" class="hs-nav__account-chip" aria-label="{{ 'My account'|t }}">
          <span class="hs-nav__avatar" aria-hidden="true">{{ account_initials|default(user.getDisplayName()|slice(0, 2)|upper) }}</span>
          <span class="hs-nav__account-text">{{ account_name|default(user.getDisplayName()) }}</span>
        </a>
      {% else %}
        <a href="{{ path('user.login') }}" class="hs-nav__account-link" aria-label="{{ 'Sign in'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17"
               fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span class="hs-nav__account-text">{{ 'Sign in'|t }}</span>
        </a>
      {% endif %}

      <a href="{{ path('commerce_cart.page') }}" class="hs-nav__cart-link" aria-label="{{ 'Cart'|t }}" data-behavior="hs-cart-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17"
             fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="hs-nav__cart-text">{{ 'Cart'|t }} · <span class="hs-nav__cart-count" aria-live="polite">{{ cart_count|default(0) }}</span></span>
      </a>
    </div>

  </div>
</header>

{# ══════════════════════════════════════════════════════════════════════════
   MAIN CONTENT
   ══════════════════════════════════════════════════════════════════════════ #}
<main id="main-content" class="hs-home" tabindex="-1">

  {# Drupal status/warning/error messages — after hero so they don't push it down #}

  {# ── HERO ────────────────────────────────────────────────────────────── #}
  <section class="hs-hero" aria-labelledby="hs-hero-heading" id="hs-hero">
    <div class="hs-hero__inner">

      {# Left: headline text #}
      <div class="hs-hero__text">
        <p class="hs-hero__eyebrow hs-mono"><span aria-hidden="true">🍯</span> {{ 'From our Iowa hives · Est. 2020'|t }}</p>
        <h1 id="hs-hero-heading" class="hs-hero__heading hs-serif">
          {{ 'Real honey. No mess. <em>Ready&nbsp;to&nbsp;go.</em>'|raw|t }}
        </h1>
        <p class="hs-hero__body">
          {{ "Single-serve sticks of raw, unfiltered honey from our family farm. Tear it open, squeeze it in — that's it. Lunchbox-friendly, pocket-sized, never sticky."|t }}
        </p>
        <div class="hs-hero__actions">
          <a href="/shop" class="hs-btn hs-btn--honey">{{ 'Shop All Flavors'|t }}</a>
          <a href="#hs-flavors" class="hs-btn hs-btn--ghost">{{ 'Shop Flavors'|t }}</a>
        </div>

        {# Stats — below buttons, inside left column #}
        <div class="hs-hero__stats">
          <div class="hs-hero__stats-inner">
            {% for stat in [
              {n: '6',     l: 'Years beekeeping'|t},
              {n: '50',    l: 'Hives in rotation'|t},
              {n: '0',     l: 'Additives, ever'|t},
            ] %}
              <div class="hs-stat">
                <span class="hs-stat__n hs-serif">{{ stat.n }}</span>
                <span class="hs-stat__l hs-mono">{{ stat.l }}</span>
              </div>
            {% endfor %}
          </div>
        </div>

      </div>{# /.hs-hero__text #}

      {# Right column: stage card only #}
      <div class="hs-hero__right">

      <div class="hs-hero__stage" role="group" aria-label="{{ 'Product preview'|t }}">
        <div class="hs-stage__head">
          <span class="hs-stage__badge hs-mono">✦ {{ 'New Batch · Wildflower'|t }}</span>
        </div>

        {# Honey sticks visual with ghost number #}
        <div class="hs-stage__visual" aria-hidden="true">
          <span class="hs-stage__ghost hs-serif" id="hs-ghost-num" aria-hidden="true">30</span>
          <svg class="hs-sticks-fan" viewBox="0 0 300 256" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="sg-hi" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="white" stop-opacity=".30"/>
                <stop offset="55%" stop-color="white" stop-opacity="0"/>
              </linearGradient>
              <linearGradient id="sg-sh" x1="0" y1="0" x2="1" y2="0">
                <stop offset="65%" stop-color="black" stop-opacity="0"/>
                <stop offset="100%" stop-color="black" stop-opacity=".14"/>
              </linearGradient>
            </defs>
            {# 13 sticks fanning from centre-bottom; outer sticks fade #}
            <g transform="translate(150 248)">
              {% for stick in [
                {r: -30, o: 0.28, c: '#b86810'},
                {r: -24, o: 0.40, c: '#c87514'},
                {r: -18, o: 0.54, c: '#d18018'},
                {r: -12, o: 0.68, c: '#d9891b'},
                {r:  -6, o: 0.82, c: '#e2941e'},
                {r:   0, o: 1.00, c: '#f0a929'},
                {r:   6, o: 0.82, c: '#e2941e'},
                {r:  12, o: 0.68, c: '#d9891b'},
                {r:  18, o: 0.54, c: '#d18018'},
                {r:  24, o: 0.40, c: '#c87514'},
                {r:  30, o: 0.28, c: '#b86810'},
              ] %}
                <g transform="rotate({{ stick.r }})" opacity="{{ stick.o }}">
                  {# Stick body #}
                  <rect x="-7" y="-232" width="14" height="222" rx="7" fill="{{ stick.c }}"/>
                  {# Highlight overlay #}
                  <rect x="-7" y="-232" width="14" height="222" rx="7" fill="url(#sg-hi)"/>
                  {# Shadow overlay #}
                  <rect x="-7" y="-232" width="14" height="222" rx="7" fill="url(#sg-sh)"/>
                  {# Sealed top cap — slightly lighter #}
                  <rect x="-7" y="-232" width="14" height="18" rx="7" fill="{{ stick.c }}"/>
                  <rect x="-7" y="-232" width="14" height="18" rx="7" fill="white" opacity=".12"/>
                  {# Inner highlight stripe #}
                  <rect x="-4" y="-228" width="5" height="70" rx="2.5" fill="white" opacity=".20"/>
                </g>
              {% endfor %}
            </g>
          </svg>
        </div>

        <p class="hs-stage__caption hs-mono">{{ 'WILDFLOWER · 30 STICKS · 7G EACH · NET WT 210G'|t }}</p>

        {# Pack size picker — JS updates price display; CTA goes to /shop #}
        <div class="hs-stage__controls">
          <p class="hs-stage__ctrl-label hs-label hs-mono">{{ 'Choose pack size'|t }}</p>
          <div class="hs-pack-grid" role="group" aria-label="{{ 'Pack sizes'|t }}">
            <button class="hs-pack-btn" data-pack="12"  data-price="9"  data-unit="0.75" aria-pressed="false">
              <span class="hs-pack-btn__n hs-serif">12</span>
              <span class="hs-pack-btn__p" id="hs-pp-12">$9</span>
            </button>
            <button class="hs-pack-btn is-active" data-pack="30" data-price="19" data-unit="0.63" aria-pressed="true">
              <span class="hs-pack-btn__badge hs-mono">{{ 'Most loved'|t }}</span>
              <span class="hs-pack-btn__n hs-serif">30</span>
              <span class="hs-pack-btn__p" id="hs-pp-30">$19</span>
            </button>
            <button class="hs-pack-btn" data-pack="60"  data-price="34" data-unit="0.57" aria-pressed="false">
              <span class="hs-pack-btn__n hs-serif">60</span>
              <span class="hs-pack-btn__p" id="hs-pp-60">$34</span>
            </button>
            <button class="hs-pack-btn" data-pack="120" data-price="59" data-unit="0.49" aria-pressed="false">
              <span class="hs-pack-btn__badge hs-mono hs-pack-btn__badge--save">{{ 'Best value'|t }}</span>
              <span class="hs-pack-btn__n hs-serif">120</span>
              <span class="hs-pack-btn__p" id="hs-pp-120">$59</span>
            </button>
          </div>
        </div>

        <div class="hs-stage__buy">
          <div class="hs-stage__price-block">
            <span class="hs-stage__price hs-serif" id="hs-hero-price">$19</span>
            <span class="hs-stage__per hs-mono" id="hs-hero-per">$0.63 / STICK</span>
          </div>
          <a href="/shop" class="hs-btn hs-btn--honey hs-stage__cta" id="hs-hero-cta">
            {{ 'Choose your flavor →'|t }}
          </a>
        </div>

        <div class="hs-stage__foot">
          <div class="hs-trust-strip hs-mono">
            <span>{{ 'Free ship $25+'|t }}</span>
            <span aria-hidden="true">·</span>
            <span>{{ 'Ships in 24h'|t }}</span>
            <span aria-hidden="true">·</span>
            <span>{{ '30-day guarantee'|t }}</span>
          </div>
        </div>
      </div>{# /.hs-hero__stage #}

      </div>{# /.hs-hero__right #}

    </div>{# /.hs-hero__inner #}

  </section>

  {# Drupal status/warning/error messages — placed after hero #}
  {% if page.highlighted %}
    <div class="hs-messages layout-container">{{ page.highlighted }}</div>
  {% endif %}

  {# ── TRUST MARQUEE ───────────────────────────────────────────────────── #}
  <div class="hs-marquee" aria-hidden="true">
    <div class="hs-marquee__track">
      {% for pass in 1..2 %}
        {% for badge in [
          'Raw & Unfiltered',
          'Single-Origin Iowa',
          'Lunchbox-Friendly',
          'Bee-Friendly Hives',
          'Cold-Pack Process',
          'No Additives, Ever',
          'Family-Run Since 2020',
          'One Ingredient',
        ] %}
          <span class="hs-marquee__item hs-mono">{{ badge|t }}</span>
          <span class="hs-marquee__sep" aria-hidden="true">·</span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  {# ── PRODUCTS SHOWCASE ───────────────────────────────────────────────── #}
  <section id="hs-flavors" class="hs-flavors-home" aria-labelledby="hs-flavors-heading">
    <div class="hs-flavors-home__inner">
      <div class="hs-flavors-home__head">
        <div>
          <p class="hs-mono hs-label">{{ '01 Shop'|t }}</p>
          <h2 id="hs-flavors-heading" class="hs-flavors-home__heading hs-serif">
            {{ 'Our honey sticks. <em>Real honey.</em>'|raw|t }}
          </h2>
        </div>
        <a href="/shop" class="hs-btn hs-btn--ghost hs-flavors-home__all-btn">{{ 'Shop all flavors →'|t }}</a>
      </div>
      {# Live product grid from the catalog view (rendered via preprocess) #}
      <div class="hs-home-products">
        {{ catalog_products }}
      </div>
    </div>
  </section>

  {# ── OUR STORY ───────────────────────────────────────────────────────── #}
  <section id="hs-story" class="hs-story" aria-labelledby="hs-story-heading">
    <div class="hs-story__inner">

      <div class="hs-story__text">
        <p class="hs-mono hs-label">{{ '03 Our Story'|t }}</p>
        <h2 id="hs-story-heading" class="hs-story__heading hs-serif">
          {{ 'A farm, <em>50 hives</em>, and one stubborn idea.'|raw|t }}
        </h2>
        <p>{{ "We started in 2020 with twelve hives behind the barn and a hunch that great honey didn't need to live in a plastic bear on a shelf. Today we tend fifty hives on unsprayed Iowa farmland, and we pack that raw honey into single-serve sticks — no jar, no spoon, no mess."|t }}</p>
        <a href="/our-story" class="hs-story__link">{{ 'Visit the farm →'|t }}</a>
      </div>

      <div class="hs-story__grid" aria-label="{{ 'Farm photo gallery'|t }}">
        {% for img in [
          {src: 'story-1.jpg', alt: 'Our beehives on the Iowa prairie'|t},
          {src: 'story-2.jpg', alt: 'Extracting raw honey at the farm'|t},
          {src: 'story-3.jpg', alt: 'Filling honey sticks by hand'|t},
          {src: 'story-4.jpg', alt: 'The family behind HiveSticks'|t},
        ] %}
          <img class="hs-story__photo" src="/themes/custom/hivesticks/images/{{ img.src }}"
               alt="{{ img.alt }}" loading="lazy">
        {% endfor %}
      </div>

    </div>
  </section>

  {# ── USE CASES ───────────────────────────────────────────────────────── #}
  <section id="hs-athletes" class="hs-uses" aria-labelledby="hs-uses-heading">
    <div class="hs-uses__inner">
      <div class="hs-uses__intro">
        <p class="hs-mono hs-label">{{ '04 Wherever you are'|t }}</p>
        <h2 id="hs-uses-heading" class="hs-uses__heading hs-serif">
          {{ 'One stick. <em>Endless</em> excuses to use it.'|raw|t }}
        </h2>
      </div>
      <div class="hs-uses__grid">
        {% for use in [
          {title: 'In your tea'|t,    body: "No drips, no spoons, no half-stuck jar in the office cabinet. Just open, squeeze, done."|t, icon: '☕'},
          {title: 'On the trail'|t,   body: "Pocket-sized fuel. 17 calories of fast-burning natural energy. Better than any gel."|t, icon: '🏔'},
          {title: 'For the kids'|t,   body: "Lunchbox-friendly. No sticky fingers, no plastic spoon, no shattered jar."|t, icon: '🧒'},
          {title: 'Before the gym'|t, body: "Athletes use it for pre-workout carbs. Real food, real fast, no aftertaste."|t, icon: '💪'},
        ] %}
          <article class="hs-use-card">
            <span class="hs-use-card__icon" aria-hidden="true">{{ use.icon }}</span>
            <h3 class="hs-use-card__title hs-serif">{{ use.title }}</h3>
            <p class="hs-use-card__body">{{ use.body }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  {# Reviews section removed — content was placeholder/generated. #}

  {# ── FAQ ─────────────────────────────────────────────────────────────── #}
  <section id="hs-faq" class="hs-faq-home" aria-labelledby="hs-faq-home-heading"
           data-behavior="hs-home-faq">
    <div class="hs-faq-home__inner">
      <div class="hs-faq-home__intro">
        <p class="hs-mono hs-label">{{ '06 Common questions'|t }}</p>
        <h2 id="hs-faq-home-heading" class="hs-faq-home__heading hs-serif">
          {{ 'Sticky details, <em>cleared up.</em>'|raw|t }}
        </h2>
      </div>
      <div class="hs-faq-home__items">
        {% for item in [
          {
            q: 'Is this real honey or syrup?'|t,
            a: "Real, raw, unfiltered honey. Nothing else. We harvest it ourselves at our Iowa farm. The ingredient list is one word: honey."|t,
          },
          {
            q: 'How much honey is in each stick?'|t,
            a: "Each stick holds 4.7 grams — about a teaspoon of raw honey. One stick sweetens a mug of tea perfectly."|t,
          },
          {
            q: 'Does honey expire?'|t,
            a: "Raw honey has an effectively unlimited shelf life. Our sticks carry a best-by date of 2 years from pack date; after that the flavor mellows but it's still safe."|t,
          },
          {
            q: 'Why is the color different in each pack?'|t,
            a: "Honey color comes from what the bees foraged. Wildflower is golden, buckwheat is near-black, clover is pale. Same process, different flowers."|t,
          },
          {
            q: 'Can kids eat them?'|t,
            a: "Yes, for children over 12 months. Raw honey is not safe for infants under one year. After that — fair game. Most kids love the format."|t,
          },
        ] %}
          <div class="hs-faq-home__item">
            <button class="hs-faq-home__q hs-serif"
                    aria-expanded="false"
                    aria-controls="hs-home-faq-{{ loop.index }}">
              {{ item.q }}
              <span class="hs-faq-home__icon" aria-hidden="true">+</span>
            </button>
            <div id="hs-home-faq-{{ loop.index }}"
                 class="hs-faq-home__a"
                 hidden>
              {{ item.a }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ── SHOP / CTA ──────────────────────────────────────────────────────── #}
  <section id="hs-shop" class="hs-cta" aria-labelledby="hs-cta-heading">
    <div class="hs-cta__inner">
      <h2 id="hs-cta-heading" class="hs-cta__heading hs-serif">
        {{ "Skip the jar. <em>Pocket the hive.</em>"|raw|t }}
      </h2>
      <p class="hs-cta__body">
        {{ "Start with the Classic 30-pack. If it isn't the best honey you've put in your tea, we'll send your money back — keep the sticks."|t }}
      </p>
      <a href="/shop" class="hs-btn hs-btn--honey hs-cta__btn">
        {{ 'Order the Classic 30-pack — $19'|t }}
      </a>
      <p class="hs-cta__trust hs-mono">
        {{ 'FREE SHIPPING · 30-DAY GUARANTEE · SHIPS IN 24H'|t }}
      </p>
    </div>
  </section>

</main>

{# ══════════════════════════════════════════════════════════════════════════
   FOOTER
   ══════════════════════════════════════════════════════════════════════════ #}
<footer class="hs-footer-home" role="contentinfo">
  <div class="hs-footer-home__inner">

    <div class="hs-footer-home__brand">
      <a href="{{ path('<front>') }}" class="hs-footer-home__logo hs-serif" aria-label="{{ 'HiveSticks home'|t }}">
        Hive<em>Sticks</em>
      </a>
      <p class="hs-footer-home__tagline">
        {{ 'Single-origin raw honey from our family farm in Story County, Iowa. Family-run since 2020.'|t }}
      </p>
    </div>

    <nav class="hs-footer-home__cols" aria-label="{{ 'Footer'|t }}">
      <div class="hs-footer-home__col">
        <h3 class="hs-footer-home__col-title hs-mono">{{ 'Shop'|t }}</h3>
        <ul>
          <li><a href="/shop">{{ 'All flavors'|t }}</a></li>
          <li><a href="/shop">{{ 'Variety pack'|t }}</a></li>
          <li><a href="/shop">{{ 'Subscription'|t }}</a></li>
          <li><a href="/wholesale">{{ 'Wholesale'|t }}</a></li>
        </ul>
      </div>
      <div class="hs-footer-home__col">
        <h3 class="hs-footer-home__col-title hs-mono">{{ 'About'|t }}</h3>
        <ul>
          <li><a href="/our-story">{{ 'Our story'|t }}</a></li>
          <li><a href="/our-story">{{ 'The farm'|t }}</a></li>
          <li><a href="/contact">{{ 'Contact'|t }}</a></li>
        </ul>
      </div>
      <div class="hs-footer-home__col">
        <h3 class="hs-footer-home__col-title hs-mono">{{ 'Help'|t }}</h3>
        <ul>
          <li><a href="#hs-faq">{{ 'FAQ'|t }}</a></li>
          <li><a href="/shipping">{{ 'Shipping'|t }}</a></li>
          <li><a href="/returns">{{ 'Returns'|t }}</a></li>
        </ul>
      </div>
    </nav>

  </div>
  <div class="hs-footer-home__legal hs-mono">
    {{ '© 2026 HIVESTICKS APIARY · IOWA · BUILT BY BEEKEEPERS · NOT MARKETERS'|t }}
  </div>
</footer>

{# ── STICKY BUY BAR (appears on scroll) ─────────────────────────────────── #}
{% if sticky_product_name %}
<div class="hs-sticky-bar" data-behavior="hs-sticky-bar" aria-hidden="true">
  <div class="hs-sticky-bar__inner">
    <span class="hs-sticky-bar__name hs-serif">{{ sticky_product_name }}</span>
    <span class="hs-sticky-bar__price">{{ sticky_product_price }}</span>
    <a href="{{ sticky_product_url }}" class="hs-btn hs-btn--honey hs-sticky-bar__cta">{{ 'Shop Now'|t }}</a>
  </div>
</div>
{% endif %}
