{#
  page--user.html.twig — HiveSticks user account pages
  ──────────────────────────────────────────────────────
  Anonymous (login/register/password): centered card in .hs-account-wrap.
  Authenticated (/user/{uid}, /orders, /address-book, /edit): the account
  area shell — sidebar rail (avatar + section nav) beside the content.

  Variables from hivesticks_preprocess_page():
    logged_in, user, user_uid,
    account_active ('orders'|'addresses'|'profile'|'overview'),
    account_initials, account_name, account_email

  Deploy to: themes/custom/hivesticks/templates/layout/page--user.html.twig
#}

{{ attach_library('hivesticks/header') }}
{{ attach_library('hivesticks/account') }}

<a class="hs-skip-link" href="#main-content">{{ 'Skip to main content'|t }}</a>

{% if page.highlighted %}
  <div class="hs-messages">{{ page.highlighted }}</div>
{% endif %}

{# ── Header / primary nav ─────────────────────────────────────────────────── #}
<header class="hs-nav" data-behavior="hs-nav" role="banner">
  <div class="hs-nav__inner">
    <a href="{{ path('<front>') }}" class="hs-nav__logo-link" aria-label="{{ 'HiveSticks — return to homepage'|t }}">
      {% if logo_url %}
        <img src="{{ logo_url }}" alt="{{ 'HiveSticks'|t }}" class="hs-nav__logo-img">
      {% else %}
        <span class="hs-nav__logo-wrap">
          <svg class="hs-nav__hex" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
            <path d="M15 2 L27 9 L27 21 L15 28 L3 21 L3 9 Z" fill="#d9871a"/>
            <path d="M15 8 C15 8 10 15 10 18.5 C10 21.54 12.24 24 15 24 C17.76 24 20 21.54 20 18.5 C20 15 15 8 15 8Z" fill="white" opacity="0.92"/>
          </svg>
          <span class="hs-nav__logo-text hs-serif">Hive<em>Sticks</em></span>
        </span>
      {% endif %}
    </a>

    <nav class="hs-nav__menu" aria-label="{{ 'Primary'|t }}">
      <ul class="hs-nav__links" role="list">
        <li><a href="/shop">{{ 'Shop'|t }}</a></li>
        <li><a href="/shop">{{ 'Flavors'|t }}</a></li>
        <li><a href="/our-story">{{ 'Our Story'|t }}</a></li>
        <li><a href="/for-families">{{ 'For Families'|t }}</a></li>
        <li><a href="{{ path('<front>') }}#hs-faq">{{ 'FAQ'|t }}</a></li>
      </ul>
    </nav>

    <div class="hs-nav__actions">
      {% if logged_in %}
        <a href="/user/{{ user_uid }}" class="hs-nav__account-chip" aria-label="{{ 'My account'|t }}">
          <span class="hs-nav__avatar" aria-hidden="true">{{ account_initials }}</span>
          <span class="hs-nav__account-text">{{ account_name }}</span>
        </a>
      {% else %}
        <a href="{{ path('user.login') }}" class="hs-nav__account-link" aria-label="{{ 'Sign in'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17"
               fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
          <span class="hs-nav__account-text">{{ 'Sign in'|t }}</span>
        </a>
      {% endif %}

      <a href="{{ path('commerce_cart.page') }}" class="hs-nav__cart-link" aria-label="{{ 'Cart'|t }}" data-behavior="hs-cart-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17"
             fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="hs-nav__cart-text">{{ 'Cart'|t }} · <span class="hs-nav__cart-count" aria-live="polite">{{ cart_count|default(0) }}</span></span>
      </a>
    </div>
  </div>
</header>

<main id="main-content" class="hs-page-main" role="main">
  {% if logged_in %}
    {# ── Mobile / topbar section tabs ── #}
    <div class="hs-acct-tabs" role="navigation" aria-label="{{ 'Account sections'|t }}">
      <div class="hs-acct-tabs__inner">
        <a href="/user/{{ user_uid }}" class="hs-acct-tabs__tab {{ account_active == 'overview' ? 'is-active' }}">{{ 'Overview'|t }}</a>
        <a href="/user/{{ user_uid }}/orders" class="hs-acct-tabs__tab {{ account_active == 'orders' ? 'is-active' }}">{{ 'Orders'|t }}</a>
        <a href="/user/{{ user_uid }}/subscriptions" class="hs-acct-tabs__tab {{ account_active == 'subscriptions' ? 'is-active' }}">{{ 'Subscriptions'|t }}</a>
        <a href="/user/{{ user_uid }}/address-book" class="hs-acct-tabs__tab {{ account_active == 'addresses' ? 'is-active' }}">{{ 'Addresses'|t }}</a>
        <a href="/user/{{ user_uid }}/rewards" class="hs-acct-tabs__tab {{ account_active == 'rewards' ? 'is-active' }}">{{ 'Rewards'|t }}</a>
        <a href="/user/{{ user_uid }}/edit" class="hs-acct-tabs__tab {{ account_active == 'profile' ? 'is-active' }}">{{ 'Profile'|t }}</a>
      </div>
    </div>

    <div class="hs-acct">
      {# ── Sidebar rail ── #}
      <aside class="hs-acct__rail">
        <div class="hs-acct__id">
          <span class="hs-acct__avatar" aria-hidden="true">{{ account_initials }}</span>
          <div class="hs-acct__id-text">
            <div class="hs-acct__id-name">{{ account_name }}</div>
            <div class="hs-acct__id-email">{{ account_email }}</div>
          </div>
        </div>
        <nav class="hs-acct__nav" aria-label="{{ 'Account'|t }}">
          <a href="/user/{{ user_uid }}" class="hs-acct__link {{ account_active == 'overview' ? 'is-active' }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 13h7V4H4zM13 20h7v-9h-7zM13 4v5h7V4zM4 20h7v-5H4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            {{ 'Overview'|t }}
          </a>
          <a href="/user/{{ user_uid }}/orders" class="hs-acct__link {{ account_active == 'orders' ? 'is-active' }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7l8-4 8 4v10l-8 4-8-4zM4 7l8 4 8-4M12 11v10" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            {{ 'Orders'|t }}
          </a>
          <a href="/user/{{ user_uid }}/subscriptions" class="hs-acct__link {{ account_active == 'subscriptions' ? 'is-active' }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 8a8 8 0 0 0-14-3M4 5v4h4M4 16a8 8 0 0 0 14 3M20 19v-4h-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ 'Subscriptions'|t }}
          </a>
          <a href="/user/{{ user_uid }}/address-book" class="hs-acct__link {{ account_active == 'addresses' ? 'is-active' }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.7"/></svg>
            {{ 'Addresses'|t }}
          </a>
          <a href="/user/{{ user_uid }}/rewards" class="hs-acct__link {{ account_active == 'rewards' ? 'is-active' }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM8.5 13L7 22l5-3 5 3-1.5-9" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            {{ 'Rewards'|t }}
          </a>
          <a href="/user/{{ user_uid }}/edit" class="hs-acct__link {{ account_active == 'profile' ? 'is-active' }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M4 20c0-3.5 3.6-6 8-6s8 2.5 8 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            {{ 'Profile'|t }}
          </a>
        </nav>
        <div class="hs-acct__rail-foot">
          <a href="{{ path('user.logout') }}" class="hs-acct__signout">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ 'Sign out'|t }}
          </a>
        </div>
      </aside>

      {# ── Content column ── #}
      <div class="hs-acct__main">
        <div class="hs-account-wrap hs-account-wrap--wide">
          {{ page.content }}
        </div>
      </div>
    </div>
  {% else %}
    <div class="hs-account-wrap">
      {{ page.content }}
    </div>
  {% endif %}
</main>
